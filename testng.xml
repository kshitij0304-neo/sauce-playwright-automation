<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="Sauce Demo Cross-Browser Suite"
       parallel="tests"
       thread-count="3">

    <test name="Chromium Login Tests">
        <parameter name="browser" value="chromium"/>

        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Firefox Login Tests">
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="WebKit Login Tests">
        <parameter name="browser" value="webkit"/>

        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>


</suite>